<!--
    Windows Setup window. Three pages share one window:
    StartPage (choose a setup), ProgressPage (live progress), FinishPage (summary).
    Controls with x:Name are found and wired up by modules\Ui.ps1.
-->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Windows Setup" Width="980" Height="700" MinWidth="860" MinHeight="600"
        WindowStartupLocation="CenterScreen" Background="#1C1C1C"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14" Foreground="#F3F3F3"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">

    <Window.Resources>
        <SolidColorBrush x:Key="Surface"     Color="#272727"/>
        <SolidColorBrush x:Key="Surface2"    Color="#2F2F2F"/>
        <SolidColorBrush x:Key="SurfaceHover" Color="#383838"/>
        <SolidColorBrush x:Key="Line"        Color="#3A3A3A"/>
        <SolidColorBrush x:Key="Muted"       Color="#A6A6A6"/>
        <SolidColorBrush x:Key="Accent"      Color="#4CA6FF"/>
        <SolidColorBrush x:Key="AccentHover" Color="#6BB6FF"/>
        <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <!-- Buttons -->
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#F3F3F3"/>
            <Setter Property="Background" Value="{StaticResource Surface2}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="#0B1A2A"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter x:Name="Cp" Margin="0,2"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource AccentHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Check boxes -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#F3F3F3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <!-- A Grid (not a StackPanel) so long text can wrap -->
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Box" Width="18" Height="18" CornerRadius="4" BorderThickness="1"
                                    BorderBrush="#8A8A8A" Background="#262626" VerticalAlignment="Center">
                                <Grid>
                                    <TextBlock x:Name="Tick" Text="&#xE73E;" FontFamily="{StaticResource Icons}" FontSize="12"
                                               Foreground="#0B1A2A" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                    <!-- "Partly selected": some, but not all, items of a step are ticked -->
                                    <Rectangle x:Name="Partial" Width="8" Height="2" Fill="#0B1A2A" Visibility="Collapsed"/>
                                </Grid>
                            </Border>
                            <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource Accent}"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="{x:Null}">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource Accent}"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter TargetName="Partial" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="#C8C8C8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Radio buttons drawn as selectable cards -->
        <Style x:Key="CardRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#F3F3F3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                                BorderThickness="1" CornerRadius="8" Padding="14,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="Dot" Width="18" Height="18" CornerRadius="9" BorderThickness="1" BorderBrush="#8A8A8A"
                                        VerticalAlignment="Center" Margin="0,0,12,0">
                                    <Ellipse x:Name="Inner" Width="8" Height="8" Fill="#0B1A2A" Visibility="Collapsed"/>
                                </Border>
                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter TargetName="Dot" Property="Background" Value="{StaticResource Accent}"/>
                                <Setter TargetName="Dot" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter TargetName="Inner" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2C2C2C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Thin progress bar -->
        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" CornerRadius="3" Background="#333333"/>
                            <Border x:Name="PART_Indicator" CornerRadius="3" Background="{StaticResource Accent}" HorizontalAlignment="Left"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Slim dark scroll bars -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10"/>
            <Setter Property="MinWidth" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border CornerRadius="3" Background="#5A5A5A" Margin="2,0"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16,14"/>
        </Style>
        <!-- Dark hover boxes with wrapped text -->
        <Style TargetType="ToolTip">
            <Setter Property="Foreground" Value="#F3F3F3"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="MaxWidth" Value="360"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="#2B2B2B" BorderBrush="#454545" BorderThickness="1" CornerRadius="6" Padding="12,8">
                            <ContentPresenter>
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                        <Setter Property="LineHeight" Value="19"/>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </Window.Resources>

    <Grid Margin="28,22,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Windows Setup" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="26" FontWeight="SemiBold"/>
                <TextBlock x:Name="VersionText" Foreground="{StaticResource Muted}" FontSize="13" Margin="10,0,0,4" VerticalAlignment="Bottom"/>
                <Border x:Name="DryRunBadge" Visibility="Collapsed" Background="#3D3415" CornerRadius="4" Padding="8,2" Margin="12,0,0,4" VerticalAlignment="Bottom">
                    <TextBlock Text="Dry run: nothing will be changed" Foreground="#FCE100" FontSize="12"/>
                </Border>
            </StackPanel>
            <TextBlock x:Name="SubtitleText" Foreground="{StaticResource Muted}" Margin="0,4,0,0" Text="Choose a setup and press Start. Everything after that is automatic."/>
        </StackPanel>

        <!-- ============================ Start page ============================ -->
        <Grid x:Name="StartPage" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="YOUR PC" Style="{StaticResource Label}"/>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                        <StackPanel x:Name="PcInfoPanel"/>
                    </Border>

                    <TextBlock Text="SETUP" Style="{StaticResource Label}"/>
                    <StackPanel x:Name="PresetPanel" Margin="0,0,0,12"/>

                    <TextBlock Text="INSTALL TYPE" Style="{StaticResource Label}"/>
                    <RadioButton x:Name="NormalRadio" Style="{StaticResource CardRadio}" GroupName="Mode" IsChecked="True">
                        <StackPanel>
                            <TextBlock Text="Normal install" FontWeight="SemiBold"/>
                            <TextBlock Text="Everything in the setup" Foreground="{StaticResource Muted}" FontSize="12"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="CustomRadio" Style="{StaticResource CardRadio}" GroupName="Mode">
                        <StackPanel>
                            <TextBlock Text="Custom install" FontWeight="SemiBold"/>
                            <TextBlock Text="Pick what runs" Foreground="{StaticResource Muted}" FontSize="12"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <TextBlock x:Name="RightTitle" Text="WHAT WILL HAPPEN" Style="{StaticResource Label}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-3,14,0">
                        <!-- Download estimate, updated with every choice -->
                        <StackPanel x:Name="SizePanel" Orientation="Horizontal" Background="Transparent">
                            <TextBlock Text="&#xE896;" FontFamily="{StaticResource Icons}" FontSize="13" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,1,6,0"/>
                            <TextBlock x:Name="SizeText" Foreground="{StaticResource Muted}" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button x:Name="SelectAllButton" Style="{StaticResource LinkButton}" Content="Select all" Margin="18,0,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <StackPanel x:Name="NormalPanel"/>
                        <StackPanel x:Name="CustomPanel" Visibility="Collapsed"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- ============================ Progress page ============================ -->
        <Grid x:Name="ProgressPage" Grid.Row="1" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <TextBlock x:Name="StepText" FontSize="18" FontWeight="SemiBold" Text="Getting ready"/>
                <TextBlock x:Name="ElapsedText" HorizontalAlignment="Right" VerticalAlignment="Bottom" Foreground="{StaticResource Muted}" Text="0:00"/>
            </Grid>
            <ProgressBar x:Name="Progress" Grid.Row="1" Minimum="0" Maximum="100" Value="0" Margin="0,0,0,16"/>
            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="6,8">
                <ListBox x:Name="LogList" Background="Transparent" BorderThickness="0" Foreground="#F3F3F3"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="{Binding Margin}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="340"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Icon}" Foreground="{Binding IconColor}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding Label}" FontWeight="{Binding Weight}" Foreground="{Binding LabelColor}"
                                           FontSize="{Binding Size}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding Value}" Foreground="{Binding ValueColor}" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" Margin="8,0,8,0"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Grid>

        <!-- ============================ Finish page ============================ -->
        <Grid x:Name="FinishPage" Grid.Row="1" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,18">
                <Border x:Name="ResultBadge" Width="52" Height="52" CornerRadius="26" Background="#1F3A26">
                    <TextBlock x:Name="ResultIcon" Text="&#xE73E;" FontFamily="{StaticResource Icons}" FontSize="24" Foreground="#6CCB5F"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="ResultTitle" FontSize="22" FontWeight="SemiBold" Text="Setup finished"/>
                    <TextBlock x:Name="ResultSubtitle" Foreground="{StaticResource Muted}" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
            <UniformGrid x:Name="CountsGrid" Grid.Row="1" Columns="4" Margin="0,0,0,18">
                <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                    <StackPanel><TextBlock Text="Done" Style="{StaticResource Label}" Margin="0"/><TextBlock x:Name="OkCount" FontSize="26" FontWeight="SemiBold" Foreground="#6CCB5F" Text="0"/></StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                    <StackPanel><TextBlock Text="Skipped" Style="{StaticResource Label}" Margin="0"/><TextBlock x:Name="SkipCount" FontSize="26" FontWeight="SemiBold" Foreground="#A6A6A6" Text="0"/></StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                    <StackPanel><TextBlock Text="Warnings" Style="{StaticResource Label}" Margin="0"/><TextBlock x:Name="WarnCount" FontSize="26" FontWeight="SemiBold" Foreground="#FCE100" Text="0"/></StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel><TextBlock Text="Failed" Style="{StaticResource Label}" Margin="0"/><TextBlock x:Name="FailCount" FontSize="26" FontWeight="SemiBold" Foreground="#FF99A4" Text="0"/></StackPanel>
                </Border>
            </UniformGrid>
            <Border Grid.Row="2" Style="{StaticResource Card}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ProblemsPanel"/>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Footer (buttons change per page) -->
        <Grid Grid.Row="2" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <!-- WrapPanel: on a narrow window the options move to a second line instead of under the buttons -->
            <WrapPanel VerticalAlignment="Center" Margin="0,0,16,0">
                <CheckBox x:Name="RestartCheck" Content="Restart when finished" IsChecked="True" Margin="0,4,24,4"/>
                <CheckBox x:Name="StartupCheck" Content="Disable unnecessary startup apps" Margin="0,4,24,4"/>
                <CheckBox x:Name="DriverCheck" Content="Disable Windows driver updates" Margin="0,4,24,4"/>
                <TextBlock x:Name="FooterText" Foreground="{StaticResource Muted}" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </WrapPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="LogButton" Content="Show log" Margin="0,0,10,0" Visibility="Collapsed"/>
                <Button x:Name="SecondaryButton" Content="Cancel" Margin="0,0,10,0" Visibility="Collapsed"/>
                <Button x:Name="PrimaryButton" Style="{StaticResource AccentButton}" Content="Start setup" MinWidth="140"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
