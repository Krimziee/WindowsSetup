<!--
    "Start the setup?" - shown when Start setup is pressed, before anything
    changes. Filled in by Show-StartConfirmation in modules\Ui.ps1.
-->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Start the setup?" Width="500" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14" Foreground="#F3F3F3"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
    <Border Background="#232323" BorderBrush="#454545" BorderThickness="1" CornerRadius="10" Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.55" Color="Black"/>
        </Border.Effect>
        <StackPanel Margin="26,22,26,22">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="&#xE768;" FontFamily="{StaticResource Icons}" FontSize="20" Foreground="{StaticResource Accent}"
                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                <TextBlock Text="Start the setup?" FontFamily="{StaticResource Display}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock x:Name="IntroText" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,16"/>

            <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,14">
                <StackPanel x:Name="StepsPanel"/>
            </Border>

            <StackPanel x:Name="FactsPanel" Margin="0,0,0,16"/>

            <Border x:Name="DryRunNote" Visibility="Collapsed" Background="#3D3415" CornerRadius="4" Padding="10,6" Margin="0,0,0,16">
                <TextBlock Text="Dry run: nothing will be changed." Foreground="#FCE100" FontSize="13"/>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" MinWidth="100" Margin="0,0,10,0"/>
                <Button x:Name="ConfirmButton" Style="{StaticResource AccentButton}" Content="Start setup" MinWidth="130"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
